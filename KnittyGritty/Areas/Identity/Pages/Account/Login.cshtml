@page
@model LoginModel

@{
    ViewData["Title"] = "Logga in";
}

<h1 class="mb-4">Logga in</h1>
<div class="col-md-4">
    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-floating mb-3">
            <input asp-for="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="Användarnamn" />
            <label asp-for="Input.UserName" class="form-label">Användarnamn</label>
            <span asp-validation-for="Input.UserName" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Lösenord" />
            <label asp-for="Input.Password" class="form-label">Lösenord</label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="checkbox mb-3">
            <label asp-for="Input.RememberMe" class="form-label">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                Kom ihåg mig
            </label>
        </div>
        <button id="login-submit" type="submit" class="btn btn-primary">Logga in</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
