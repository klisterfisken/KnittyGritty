@page
@model KnittyGritty.Pages.Yarns.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
        <h1>Create</h1>
        
    <h4>Yarn</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Yarn.YarnBrandID" class="control-label"></label>
                <select asp-for="Yarn.YarnBrandID" class ="form-control" asp-items="ViewBag.YarnBrandID" ></select>
            </div>
            <div class="form-group">
                <label asp-for="Yarn.Name" class="control-label"></label>
                <input asp-for="Yarn.Name" class="form-control" />
