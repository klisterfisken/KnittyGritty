@page
@model KnittyGritty.Pages.Yarns.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Yarn</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Yarn.YarnID" />
            <div class="form-group">
                <label asp-for="Yarn.YarnBrandID" class="control-label"></label>
                <select asp-for="Yarn.YarnBrandID" class="form-control" asp-items="ViewBag.YarnBrandID" ></select>
                <span asp-validation-for="Yarn.YarnBrandID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yarn.Name" class="control-label"></label>
                <input asp-for="Yarn.Name" class="form-control" />
                <span asp-validation-for="Yarn.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yarn.YarnWeight" class="control-label"></label>
                <input asp-for="Yarn.YarnWeight" class="form-control" />
                <span asp-validation-for="Yarn.YarnWeight" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yarn.UnitWeight" class="control-label"></label>
                <input asp-for="Yarn.UnitWeight" class="form-control" />
                <span asp-validation-for="Yarn.UnitWeight" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yarn.Meterage" class="control-label"></label>
                <input asp-for="Yarn.Meterage" class="form-control" />
                <span asp-validation-for="Yarn.Meterage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yarn.FiberContent" class="control-label"></label>
                <input asp-for="Yarn.FiberContent" class="form-control" />
                <span asp-validation-for="Yarn.FiberContent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
