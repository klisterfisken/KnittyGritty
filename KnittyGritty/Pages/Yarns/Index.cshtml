@page
@model KnittyGritty.Pages.Yarns.IndexModel

@{
    ViewData["Title"] = "Garner";
}

<h1>Garner</h1>

<p>
    <a class="btn btn-secondary" asp-page="Create">Lägg till</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].YarnBrand)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].YarnWeight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].UnitWeight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].Meterage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].FiberContent)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Yarn) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.YarnBrand.YarnBrandName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.YarnWeight)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitWeight)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Meterage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FiberContent)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.YarnID"><i class="bi bi-pencil-fill"></i></a>
                <a asp-page="./Details" asp-route-id="@item.YarnID"><i class="bi bi-info-circle-fill"></i></a>
                <a asp-page="./Delete" asp-route-id="@item.YarnID"><i class="bi bi-trash3-fill"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>
