@page
@model KnittyGritty.Pages.Patterns.DetailsModel

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    ViewData["Title"] = Model.Pattern.Title;
    var sizes = Model.Pattern.PatternSizes.OrderBy(ps => ps.Size.SortOrder).ToList();
    var sizeYarns = Model.Pattern.PatternSizeYarns.ToList();
    var yarns = Model.Pattern.PatternYarns.ToList();
    bool hasCircumference = sizes.Any(ps => ps.Circumference > 0);
}

<h1>@Model.Pattern.Title</h1>
<h5 class="text-muted">@Model.Pattern.Designer.Name</h5>
<div class="row">
    <div class="col">
        <hr />
        <dl class="row">
            @if (!string.IsNullOrEmpty(Model.Pattern.Craft))
            {
                <dt class="col-sm-3">Teknik</dt>
                <dd class="col-sm-9">@Model.Pattern.Craft</dd>
            }
            @if (!string.IsNullOrEmpty(Model.Pattern.PatternType))
            {
                <dt class="col-sm-3">Mönstertyp</dt>
                <dd class="col-sm-9">@Model.Pattern.PatternType</dd>
            }
            @if (!string.IsNullOrEmpty(Model.Pattern.Source))
            {
                <dt class="col-sm-3">Källa</dt>
                <dd class="col-sm-9">@Model.Pattern.Source</dd>
            }
            <dt class="col-sm-3">Masktäthet</dt>
            <dd class="col-sm-9">
                @Model.Pattern.Gauge m
                @if (!string.IsNullOrEmpty(Model.Pattern.GaugePattern))
                {
                    @Model.Pattern.GaugePattern.ToLower()
                }
                = 10 cm
            </dd>

            <dt class="col-sm-3">Stickor / Virknål</dt>
            <dd class="col-sm-9">@Model.Pattern.Needles.ToString("F2") mm</dd>

            @if (Model.Pattern.MultipleStrands && !string.IsNullOrEmpty(Model.Pattern.OverallYarnWeight))
            {
                <dt class="col-sm-3">Sammanlagd grovlek</dt>
                <dd class="col-sm-9">@Model.Pattern.OverallYarnWeight</dd>
            }

            @if (!string.IsNullOrEmpty(Model.Pattern.Notes))
            {
                <dt class="col-sm-3">Anteckningar</dt>
                <dd class="col-sm-9">@Model.Pattern.Notes</dd>
            }

            @if (Model.Pattern.PatternCategories.Any())
            {
                <dt class="col-sm-3">Kategorier</dt>
                <dd class="col-sm-9">@string.Join(", ", Model.Pattern.PatternCategories.Select(pc => pc.Category.CategoryName))</dd>
            }
    
            @if (Model.Pattern.PatternLanguages.Any())
            {
                <dt class="col-sm-3">Språk</dt>
                <dd class="col-sm-9">@string.Join(", ", Model.Pattern.PatternLanguages.Select(pl => pl.Language.LanguageName))</dd>
            }

            @if (yarns.Any())
            {
                <dt class="col-sm-3 mt-3">Garn</dt>
                <dd class="col-sm-9 mt-3">
                    @foreach (var py in yarns)
                    {
                        <div>
                            @py.Yarn.YarnBrand.YarnBrandName @py.Yarn.Name
                            @if (!string.IsNullOrEmpty(py.Color))
                            {
                                <span class="text-muted">(@py.Color)</span>
                            }
                        </div>
                    }
                </dd>
            }
        </dl>
    </div>
    @{
        var detailImgFile = $"p{Model.Pattern.PatternID:D3}.jpg";
        var detailImgExists = System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "images", detailImgFile));
        var detailImgPath = detailImgExists ? $"~/images/{detailImgFile}" : null;
    }
    @if (detailImgPath != null)
    {
        <div class="col-md-3 text-end">
            <a href="#" class="img-modal-trigger" data-img="@Url.Content(detailImgPath)">
                <div class="img-zoom-wrapper">
                    <img src="@Url.Content(detailImgPath)" alt="@Model.Pattern.Title" class="img-fluid" />
                    <i class="bi bi-zoom-in img-zoom-icon"></i>
                </div>
            </a>
        </div>
    }

</div>

@if (hasCircumference)
{
    <h4 class="mt-4">Storleksguide</h4>
    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th></th>
                @foreach (var ps in sizes)
                {
                    <th>@ps.Size.SizeName</th>
                }
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Omkrets</td>
                @foreach (var ps in sizes)
                {
                    <td>@(ps.Circumference > 0 ? $"{ps.Circumference} cm" : "-")</td>
                }
            </tr>
        </tbody>
    </table>
}

@if (sizeYarns.Any())
{
    <h4 class="mt-4">Garnåtgång</h4>
    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th>Garn</th>
                @foreach (var ps in sizes)
                {
                    <th>@ps.Size.SizeName</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var yarn in sizeYarns.Select(psy => new { psy.YarnID, psy.Yarn, psy.Color }).DistinctBy(x => new { x.YarnID, x.Color }))
            {
                <tr>
                    <td>
                        @yarn.Yarn.YarnBrand.YarnBrandName @yarn.Yarn.Name
                        @if (!string.IsNullOrEmpty(yarn.Color))
                        {
                            <span class="text-muted">(@yarn.Color)</span>
                        }
                    </td>
                    @foreach (var ps in sizes)
                    {
                        var entry = sizeYarns.FirstOrDefault(psy => psy.YarnID == yarn.YarnID && psy.SizeID == ps.SizeID && psy.Color == yarn.Color);
                        var meters = entry == null ? 0 : (entry.MeterageUsage > 0 ? entry.MeterageUsage : (int)((float)entry.GramUsage / entry.Yarn.UnitWeight * entry.Yarn.Meterage));
                        <td>@(meters > 0 ? $"{meters} m" : "-")</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Pattern.PatternID"
        asp-route-returnUrl="@Url.Page("./Details", new {id = Model.Pattern.PatternID})"
        class="btn btn-outline-secondary btn-sm">Redigera grundinfo</a>
    <a asp-page="./AddYarnUsage"
       asp-route-id="@Model.Pattern.PatternID"
       asp-route-returnUrl="@Url.Page("./Details", new { id = Model.Pattern.PatternID })"
       class="btn btn-outline-secondary btn-sm ms-2">Redigera garnåtgång</a>

    <a asp-page="./Index" class="btn btn-outline-secondary btn-sm ms-2">Tillbaka</a>
</div>

<div class="modal fade" id="imageModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" class="img-fluid" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/patterns-index.js"></script>
}
