@page
@model KnittyGritty.Pages.Designers.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Designer[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Designer[0].Alias)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Designer[0].Website)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Designer[0].Handle)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Designer) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Alias)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Website)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Handle)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.DesignerID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.DesignerID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.DesignerID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
