@page
@model KnittyGritty.Pages.YarnBrands.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Garnmärken</h1>

<p>
    <a asp-page="Create">Lägg till</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.YarnBrand[0].YarnBrandName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.YarnBrand) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.YarnBrandName)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.YarnBrandID">Ändra</a> |
                <a asp-page="./Details" asp-route-id="@item.YarnBrandID">Detaljer</a> |
                <a asp-page="./Delete" asp-route-id="@item.YarnBrandID">Ta bort</a>
            </td>
        </tr>
}
    </tbody>
</table>
