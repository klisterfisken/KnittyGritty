@page
@model KnittyGritty.Pages.YarnBrands.IndexModel

@{
    ViewData["Title"] = "Garnmärken";
}

<h1>Garnmärken</h1>

<p>
    <a class="btn btn-secondary" asp-page="Create">Lägg till</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.YarnBrand[0].YarnBrandName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.YarnBrand) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.YarnBrandName)
            </td>
            <td>
                    <a asp-page="./Edit" asp-route-id="@item.YarnBrandID"><i class="bi bi-pencil-fill"></i></a>
                    <a asp-page="./Details" asp-route-id="@item.YarnBrandID"><i class="bi bi-info-circle-fill"></i></a>
                    <a asp-page="./Delete" asp-route-id="@item.YarnBrandID"><i class="bi bi-trash3-fill"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>
