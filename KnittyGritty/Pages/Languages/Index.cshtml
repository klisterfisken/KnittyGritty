@page
@model KnittyGritty.Pages.Languages.IndexModel

@{
    ViewData["Title"] = "Språk";
}

<h1>Språk</h1>

<p>
    <a asp-page="Create">Lägg till</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Language[0].LanguageName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Language) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LanguageName)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.LanguageID"><i class="bi bi-pencil-fill"></i></a>
                <a asp-page="./Details" asp-route-id="@item.LanguageID"><i class="bi bi-info-circle-fill"></i></a>
                <a asp-page="./Delete" asp-route-id="@item.LanguageID"><i class="bi bi-trash3-fill"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>
