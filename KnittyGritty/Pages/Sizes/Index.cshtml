@page
@model KnittyGritty.Pages.Sizes.IndexModel

@{
    ViewData["Title"] = "Storlekar";
}

<h1>Storlekar</h1>

<p>
    <a class="btn btn-secondary" asp-page="Create">Lägg till</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Size[0].SizeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Size[0].SortOrder)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Size) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SizeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SortOrder)
            </td>
            <td>
                    <a asp-page="./Edit" asp-route-id="@item.SizeID"><i class="bi bi-pencil-fill"></i></a>
                    <a asp-page="./Details" asp-route-id="@item.SizeID"><i class="bi bi-info-circle-fill"></i></a>
                    <a asp-page="./Delete" asp-route-id="@item.SizeID"><i class="bi bi-trash3-fill"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>
